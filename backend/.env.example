# Wattra backend runtime env
# Copy to backend/.env for local development. In production set these in your
# host dashboard instead of committing secrets.

# Required for production. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-before-deploy

# Required for assistant requests. Without it, the assistant returns 503.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# SQLite location. Use a persistent volume path in production.
WATTRA_DB=../wattra.db

# Comma-separated origins for deployed web/mobile clients.
# Local Expo can use *, production should use your web/domain URL.
WATTRA_CORS_ORIGINS=*
WATTRA_ALLOWED_HOSTS=api.example.com,localhost,127.0.0.1
WATTRA_ENABLE_DOCS=0
WATTRA_ENABLE_LEGACY_REGISTER=0
WATTRA_WEB_DIST=

# Optional semantic memory flag.
WATTRA_SEMANTIC_MEMORY=0
LOG_LEVEL=INFO
